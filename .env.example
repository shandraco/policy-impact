# Copy to .env and replace every CHANGE. Make each key with: openssl rand -hex 32
# .env is git-ignored. Hermes and Open WebUI never read this file; compose hands each container only what it needs.

# --- keys (CHANGE all of them) ---
POSTGRES_PASSWORD=CHANGE
PI_APP_PASSWORD=CHANGE
SCOPE_SIGNING_KEY=CHANGE          # also pasted into the Open WebUI filter's settings; Hermes never gets it
LINK_SIGNING_KEY=CHANGE
TOOL_KEY=CHANGE                   # Hermes plugin -> /tools
GATE_KEY=CHANGE                   # Hermes -> model gate
HERMES_API_KEY=CHANGE             # Open WebUI -> Hermes
WEBUI_SECRET_KEY=CHANGE
LLM_API_KEY=CHANGE                # policy-api -> vLLM

# --- address people use ---
PUBLIC_BASE_URL=https://policy.example.org
PUBLIC_PORT=8080
ALLOWED_HOSTS=policy-api,localhost

# --- sign-in (any OpenID Connect provider: Entra ID, Google Workspace, Okta, Keycloak) ---
OPENID_PROVIDER_URL=https://login.example.org/.well-known/openid-configuration
OAUTH_CLIENT_ID=CHANGE
OAUTH_CLIENT_SECRET=CHANGE
OAUTH_PROVIDER_NAME=Sign in with work account
OAUTH_ALLOWED_DOMAINS=example.org

# --- pinned images and code ---
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:CHANGE-to-a-version-tag
HERMES_REF=0319e113c9602b86ffda350e931cb4b035e1d5d8
VLLM_IMAGE=vllm/vllm-openai:v0.10.2
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.8

# --- documents ---
DOC_STORE_DIR=./samples/store     # one folder per entity, plus entities.yaml
INGEST_EVERY_S=900

# --- models (FAKE_MODELS=1 runs the whole system with simple stand-ins, no GPU) ---
FAKE_MODELS=1
CHAT_URL=http://chat:8000/v1
CHAT_MODEL=chat
JUDGE_URL=http://judge:8000/v1
JUDGE_MODEL=judge
EMBED_URL=http://embed
RERANK_URL=
POLICY_ID_PATTERN=[A-Z]{2,6}-\d{1,5}
